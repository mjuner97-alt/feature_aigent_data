<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.mapper.mysql.SkillOperationHistoryMapper">

    <resultMap id="BaseResultMap" type="com.agentscopea2a.entity.SkillOperationHistory">
        <id column="id" property="id"/>
        <result column="skill_id" property="skillId"/>
        <result column="publish_id" property="publishId"/>
        <result column="operator" property="operator"/>
        <result column="operation" property="operation"/>
        <result column="before_data" property="beforeData"/>
        <result column="after_data" property="afterData"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="cols">id, skill_id, publish_id, operator, operation, before_data, after_data, created_at</sql>

    <insert id="insert" parameterType="com.agentscopea2a.entity.SkillOperationHistory"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO skill_operation_history (skill_id, publish_id, operator, operation, before_data, after_data)
        VALUES (#{skillId}, #{publishId}, #{operator}, #{operation}, #{beforeData}, #{afterData})
    </insert>

    <select id="selectBySkillId" resultMap="BaseResultMap">
        SELECT <include refid="cols"/> FROM skill_operation_history WHERE skill_id = #{skillId} ORDER BY created_at DESC
    </select>

    <select id="selectByOperator" resultMap="BaseResultMap">
        SELECT <include refid="cols"/> FROM skill_operation_history WHERE operator = #{operator} ORDER BY created_at DESC
    </select>

</mapper>
