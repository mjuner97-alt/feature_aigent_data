<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.mapper.mysql.SkillApprovalMapper">

    <resultMap id="BaseResultMap" type="com.agentscopea2a.entity.SkillApproval">
        <id column="id" property="id"/>
        <result column="publish_id" property="publishId"/>
        <result column="draft_id" property="draftId"/>
        <result column="action" property="action"/>
        <result column="operator" property="operator"/>
        <result column="comment" property="comment"/>
        <result column="version_snapshot" property="versionSnapshot"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="cols">id, publish_id, draft_id, action, operator, comment, version_snapshot, created_at</sql>

    <insert id="insert" parameterType="com.agentscopea2a.entity.SkillApproval"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO skill_approval (publish_id, draft_id, action, operator, comment, version_snapshot)
        VALUES (#{publishId}, #{draftId}, #{action}, #{operator}, #{comment}, #{versionSnapshot})
    </insert>

    <select id="selectByPublishId" resultMap="BaseResultMap">
        SELECT <include refid="cols"/> FROM skill_approval WHERE publish_id = #{publishId} ORDER BY created_at ASC
    </select>

    <select id="selectByDraftId" resultMap="BaseResultMap">
        SELECT <include refid="cols"/> FROM skill_approval WHERE draft_id = #{draftId} ORDER BY created_at ASC
    </select>

</mapper>
