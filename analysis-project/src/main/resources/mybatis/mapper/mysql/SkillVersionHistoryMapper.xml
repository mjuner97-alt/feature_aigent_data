<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.v2.skillManager.mapper.SkillVersionHistoryMapper">

    <resultMap id="BaseResultMap" type="com.agentscopea2a.v2.skillManager.entity.SkillVersionHistory">
        <id column="id" property="id"/>
        <result column="skill_id" property="skillId"/>
        <result column="version" property="version"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="content" property="content"/>
        <result column="category" property="category"/>
        <result column="tags" property="tags"/>
        <result column="edited_by" property="editedBy"/>
        <result column="edit_reason" property="editReason"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="cols">id, skill_id, version, name, description, content, category, tags, edited_by, edit_reason, created_at</sql>

    <insert id="insert" parameterType="com.agentscopea2a.v2.skillManager.entity.SkillVersionHistory"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO skill_version_history (skill_id, version, name, description, content, category, tags, edited_by, edit_reason)
        VALUES (#{skillId}, #{version}, #{name}, #{description}, #{content}, #{category}, #{tags}, #{editedBy}, #{editReason})
    </insert>

    <select id="selectBySkillId" resultMap="BaseResultMap">
        SELECT <include refid="cols"/> FROM skill_version_history WHERE skill_id = #{skillId} ORDER BY version DESC
    </select>

    <select id="selectMaxVersion" resultType="java.lang.Integer">
        SELECT MAX(version) FROM skill_version_history WHERE skill_id = #{skillId}
    </select>

</mapper>
