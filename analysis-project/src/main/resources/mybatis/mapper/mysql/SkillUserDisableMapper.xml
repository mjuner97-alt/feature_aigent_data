<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.v2.skillManager.mapper.SkillUserDisableMapper">

    <resultMap id="BaseResultMap" type="com.agentscopea2a.v2.skillManager.entity.SkillUserDisable">
        <id column="id" property="id"/>
        <result column="skill_id" property="skillId"/>
        <result column="user_id" property="userId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="cols">id, skill_id, user_id, created_at</sql>

    <insert id="insert" parameterType="com.agentscopea2a.v2.skillManager.entity.SkillUserDisable"
            useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO skill_user_disable (skill_id, user_id)
        VALUES (#{skillId}, #{userId})
    </insert>

    <delete id="deleteByUserSkill">
        DELETE FROM skill_user_disable WHERE user_id = #{userId} AND skill_id = #{skillId}
    </delete>

    <select id="existsByUserSkill" resultType="boolean">
        SELECT COUNT(1) &gt; 0 FROM skill_user_disable WHERE user_id = #{userId} AND skill_id = #{skillId}
    </select>

    <select id="selectDisabledSkillIds" resultType="java.lang.Long">
        SELECT skill_id FROM skill_user_disable
        WHERE user_id = #{userId}
        AND skill_id IN
        <foreach collection="skillIds" item="skillId" open="(" separator="," close=")">
            #{skillId}
        </foreach>
    </select>

</mapper>
