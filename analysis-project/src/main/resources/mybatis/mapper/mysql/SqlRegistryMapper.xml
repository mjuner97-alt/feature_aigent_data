<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.mapper.mysql.SqlRegistryMapper">

    <resultMap id="BaseResultMap" type="com.agentscopea2a.entity.SqlRegistryEntry">
        <id     column="id"             property="id"/>
        <result column="sql_id"         property="sqlId"/>
        <result column="name"           property="name"/>
        <result column="description"    property="description"/>
        <result column="datasource"     property="datasource"/>
        <result column="sql_template"   property="sqlTemplate"/>
        <result column="params_schema"  property="paramsSchema"/>
        <result column="enabled"        property="enabled"/>
        <result column="created_at"     property="createdAt"/>
        <result column="updated_at"     property="updatedAt"/>
        <result column="created_by"     property="createdBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, sql_id, name, description, datasource, sql_template, params_schema,
        enabled, created_at, updated_at, created_by
    </sql>

    <select id="selectBySqlId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sql_registry
        WHERE sql_id = #{sqlId}
          AND enabled = 1
    </select>

    <select id="listAllEnabled" resultMap="BaseResultMap">
        SELECT id, sql_id, name, description, datasource, params_schema, enabled, created_at, updated_at
        FROM sql_registry
        WHERE enabled = 1
        ORDER BY sql_id
    </select>

</mapper>
