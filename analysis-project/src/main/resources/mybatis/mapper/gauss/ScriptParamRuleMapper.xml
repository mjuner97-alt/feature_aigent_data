<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.v2.skillManager.mapper.ScriptParamRuleMapper">

    <resultMap id="BaseResultMap" type="com.agentscopea2a.v2.skillManager.entity.ScriptParamRule">
        <id     column="id"             property="id"/>
        <result column="rule_key"       property="ruleKey"/>
        <result column="rule_name"      property="ruleName"/>
        <result column="value_type"     property="valueType"/>
        <result column="period_unit"    property="periodUnit"/>
        <result column="format_pattern" property="formatPattern"/>
        <result column="offset_start"   property="offsetStart"/>
        <result column="offset_end"     property="offsetEnd"/>
        <result column="sort_order"     property="sortOrder"/>
        <result column="enabled"        property="enabled"/>
        <result column="description"    property="description"/>
        <result column="created_at"     property="createdAt"/>
        <result column="updated_at"     property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, rule_key, rule_name, value_type, period_unit, format_pattern,
        offset_start, offset_end, sort_order, enabled, description, created_at, updated_at
    </sql>

    <!-- 按 rule_key 查询 (仅启用): 执行时参数解析与流程定义校验共用 -->
    <select id="selectByRuleKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM script_param_rule
        WHERE rule_key = #{ruleKey}
          AND enabled = 1
    </select>

</mapper>
