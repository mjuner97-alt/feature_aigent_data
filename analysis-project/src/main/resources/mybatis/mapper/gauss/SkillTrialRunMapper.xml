<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentscopea2a.v2.skillManager.mapper.SkillTrialRunMapper">

    <resultMap id="SkillTrialRunResultMap" type="com.agentscopea2a.v2.skillManager.entity.SkillTrialRun">
        <id     column="id"              property="id"/>
        <result column="skill_id"        property="skillId"/>
        <result column="skill_name"      property="skillName"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="question"        property="question"/>
        <result column="user_id"         property="userId"/>
        <result column="created_at"      property="createdAt"/>
    </resultMap>

    <sql id="cols">id, skill_id, skill_name, conversation_id, question, user_id, created_at</sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO skill_trial_run (skill_id, skill_name, conversation_id, question, user_id)
        VALUES (#{skillId}, #{skillName}, #{conversationId}, #{question}, #{userId})
    </insert>

    <select id="selectBySkillId" resultMap="SkillTrialRunResultMap">
        SELECT <include refid="cols"/> FROM skill_trial_run
        WHERE skill_id = #{skillId}
        <!-- 可选:仅取 skill 最后修改时间之后的记录(试运行结果查看用) -->
        <if test="afterTime != null">
            AND created_at &gt; #{afterTime}
        </if>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

</mapper>
